{
  "name": "@glowhop/solid-tour",
  "version": "1.5.0",
  "description": "Solid product tour and onboarding tour components for GlowTour.js. Accessible, SSR-safe with SolidStart, MIT licensed.",
  "license": "MIT",
  "homepage": "https://glowtour.dev/solid/",
  "bugs": {
    "url": "https://github.com/Glowhop/GlowTour.js/issues"
  },
  "keywords": [
    "tour",
    "guided-tour",
    "product-tour",
    "onboarding",
    "walkthrough",
    "user-onboarding",
    "tooltip",
    "spotlight",
    "typescript",
    "solid",
    "solidjs",
    "solid-tour",
    "onboarding-tour",
    "solid-start"
  ],
  "engines": {
    "node": ">=18.19.1"
  },
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glowhop/GlowTour.js.git",
    "directory": "packages/solid"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "dependencies": {
    "@glowhop/core-tour": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "happy-dom": "^18.0.1",
    "solid-js": "^1.9.14"
  }
}
