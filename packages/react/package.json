{
  "name": "@glowhop/react-tour",
  "version": "0.1.0",
  "description": "React adapter for GlowTour.js.",
  "license": "MIT",
  "homepage": "https://github.com/Glowhop/GlowTour.js#readme",
  "bugs": {
    "url": "https://github.com/Glowhop/GlowTour.js/issues"
  },
  "keywords": [
    "tour",
    "guided-tour",
    "react",
    "onboarding"
  ],
  "engines": {
    "node": ">=18.19.1"
  },
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glowhop/GlowTour.js.git",
    "directory": "packages/react"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "dependencies": {
    "@glowhop/core-tour": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react-dom": "^19.2.0",
    "@types/react": "^19.2.0",
    "happy-dom": "^18.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
