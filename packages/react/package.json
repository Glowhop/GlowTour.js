{
  "name": "@glowhop/react-tour",
  "version": "1.4.0",
  "description": "React product tour and onboarding tour components for GlowTour.js. Accessible, SSR-safe with Next.js, MIT licensed.",
  "license": "MIT",
  "homepage": "https://glowtour.dev/react/",
  "bugs": {
    "url": "https://github.com/Glowhop/GlowTour.js/issues"
  },
  "keywords": [
    "tour",
    "guided-tour",
    "product-tour",
    "onboarding",
    "walkthrough",
    "user-onboarding",
    "tooltip",
    "spotlight",
    "typescript",
    "react",
    "react-tour",
    "joyride",
    "driver-js-alternative",
    "onboarding-tour",
    "nextjs"
  ],
  "engines": {
    "node": ">=18.19.1"
  },
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glowhop/GlowTour.js.git",
    "directory": "packages/react"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "dependencies": {
    "@glowhop/core-tour": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react-dom": "^19.3.0",
    "@types/react": "^19.3.0",
    "happy-dom": "^18.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
