{
  "name": "@glowhop/styles-tour",
  "version": "0.1.0",
  "description": "Default CSS theme for GlowTour.js.",
  "license": "MIT",
  "homepage": "https://github.com/Glowhop/GlowTour.js#readme",
  "bugs": {
    "url": "https://github.com/Glowhop/GlowTour.js/issues"
  },
  "keywords": [
    "tour",
    "guided-tour",
    "css"
  ],
  "engines": {
    "node": ">=18.19.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glowhop/GlowTour.js.git",
    "directory": "packages/styles"
  },
  "type": "module",
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./default.css": {
      "types": "./dist/default.css.d.ts",
      "default": "./dist/default.css"
    }
  }
}
