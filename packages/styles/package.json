{
  "name": "@glowhop/styles-tour",
  "version": "1.4.0",
  "description": "Default CSS theme for GlowTour.js product tours and onboarding tours, customizable with CSS custom properties.",
  "license": "MIT",
  "homepage": "https://glowtour.dev/",
  "bugs": {
    "url": "https://github.com/Glowhop/GlowTour.js/issues"
  },
  "keywords": [
    "tour",
    "guided-tour",
    "product-tour",
    "onboarding",
    "walkthrough",
    "user-onboarding",
    "tooltip",
    "spotlight",
    "typescript",
    "css",
    "theme",
    "css-variables",
    "onboarding-tour"
  ],
  "engines": {
    "node": ">=18.19.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glowhop/GlowTour.js.git",
    "directory": "packages/styles"
  },
  "type": "module",
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./default.css": {
      "types": "./dist/default.css.d.ts",
      "default": "./dist/default.css"
    }
  }
}
