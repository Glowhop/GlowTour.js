{
  "name": "@glowhop/angular-tour",
  "version": "0.1.0",
  "description": "Angular 18 adapter for Glow Tour.",
  "license": "MIT",
  "homepage": "https://github.com/Glowhop/glow-tour#readme",
  "bugs": {
    "url": "https://github.com/Glowhop/glow-tour/issues"
  },
