{
  "name": "@glowhop/screen-readers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test": "vite build && playwright test",
    "test:voiceover": "vite build && playwright test --config playwright.screen-reader.config.ts voiceover.pw.ts",
    "test:nvda": "vite build && playwright test --config playwright.screen-reader.config.ts nvda.pw.ts"
  },
  "dependencies": {
    "@angular/common": "^18.2.14",
    "@angular/compiler": "^18.2.14",
    "@angular/core": "^18.2.14",
    "@angular/platform-browser": "^18.2.14",
    "@glowhop/angular-tour": "workspace:*",
    "@glowhop/core-tour": "workspace:*",
    "@glowhop/react-tour": "workspace:*",
    "@glowhop/solid-tour": "workspace:*",
    "@glowhop/styles-tour": "workspace:*",
    "@glowhop/vanilla-tour": "workspace:*",
    "@glowhop/vue-tour": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solid-js": "^1.9.14",
    "vue": "^3.5.13",
    "zone.js": "^0.14.10"
  },
  "devDependencies": {
    "@guidepup/guidepup": "^0.34.0",
    "@guidepup/playwright": "^0.19.1",
    "@guidepup/setup": "^0.25.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.11",
    "vite-plugin-solid": "^2.11.13"
  }
}
