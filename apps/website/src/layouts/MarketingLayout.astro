---
import { ClientRouter } from "astro:transitions";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import SiteTour from "../components/SiteTour.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** A 1200x630 social card under public/og/. Every marketing page passes its own. */
  image?: string;
  imageAlt?: string;
  /** Keeps the page out of search results, and drops its canonical: the 404 page. */
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/og/home.jpg",
  imageAlt = "GlowTour.js - product tours and onboarding tours for JavaScript",
  noindex = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    {/*
      Applies the stored theme before first paint, so a visitor who picked dark never sees a white
      flash. Inline and blocking on purpose: deferring it is the flash. Reads Starlight's own key,
      so the choice carries over from the docs; the absence of a value means "follow the system",
      which is why the attributes are removed rather than resolved. `data-glow-tour-theme` is the
      same switch for the tour popovers themselves (packages/styles/default.css).
    */}
    <script is:inline>
      (() => {
        const apply = () => {
          let stored = null;
          try {
            stored = localStorage.getItem("starlight-theme");
          } catch {}
          const root = document.documentElement;
          if (stored === "light" || stored === "dark") {
            root.dataset.theme = stored;
            root.dataset.glowTourTheme = stored;
          } else {
            delete root.dataset.theme;
            delete root.dataset.glowTourTheme;
          }
        };
        apply();
        // A swap replaces the <html> attributes with the ones the server rendered, which do not
        // carry the visitor's choice. Re-applying before the new page paints keeps the theme from
        // flickering back to the system one on every navigation.
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"}
    />
    <meta name="theme-color" content="#0b0a10" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GlowTour.js" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {/*
      Fraunces is self-hosted (src/styles/fonts.css). The latin subset is preloaded because the h1
      is set in it: without the hint the file is only discovered once the stylesheet is parsed.
    */}
    <link
      rel="preload"
      href="/fonts/fraunces-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/*
      Client-side navigation between the marketing pages. Links into /docs still do a full
      navigation, because Starlight is a different shell and cross-fading between the two reads as
      a glitch rather than a transition.

      The router keeps one document alive for the whole visit, which is what lets the site tour walk
      from page to page without being torn down and rebuilt. Scripts are not re-evaluated on a swap,
      so anything that binds to elements has to re-bind on astro:page-load - see SiteTour,
      InstallLine and copy-buttons.
    */}
    {/*
      The router turns off the browser's own scroll restoration and re-applies the saved offset
      itself, from a module script - that is, after the first paint. A reload therefore shows the
      top of the page for a frame and then jumps back down. The router only needs manual
      restoration for its own client-side swaps, so for a browser-driven reload the native
      restoration is handed back here: it lands before the first paint, and the router's own
      scrollTo then targets the same coordinates and stays invisible. Inline and blocking on
      purpose - it has to run before the router's script does. `moveToLocation` sets the mode back
      to "manual" on the next router navigation.
    */}
    <script is:inline>
      if (performance.getEntriesByType("navigation")[0]?.type === "reload") {
        history.scrollRestoration = "auto";
      }
    </script>

    <ClientRouter />
  </head>
  <body class="min-h-screen bg-surface text-text antialiased">
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <SiteTour />
    <script>
      import "../lib/copy-buttons";
    </script>
  </body>
</html>
