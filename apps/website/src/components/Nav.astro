---
import { Icon } from "astro-icon/components";
import LogoMark from "./LogoMark.astro";
---

<header
  class="border-b border-[var(--color-border)] bg-[var(--color-surface)]/90 backdrop-blur sticky top-0 z-50"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4">
    <a href="/" class="flex items-center gap-2 font-semibold text-[var(--color-text)]">
      <LogoMark variant="square" class="h-6 w-6" />
      Glow Tour
    </a>
    <div class="flex items-center gap-3">
      <a
        href="https://github.com/Glowhop/glow-tour"
        class="flex items-center gap-1.5 text-sm text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text)]"
      >
        <Icon name="logos:github-icon" class="h-4 w-4" />
        GitHub
      </a>
      <a
        href="/docs/getting-started"
        class="rounded-[var(--radius-glow)] bg-[var(--color-accent)] px-4 py-2 text-sm font-semibold text-[var(--color-on-accent)] transition-colors hover:bg-[var(--color-accent-hover)]"
      >
        Get started
      </a>
    </div>
  </div>
</header>
