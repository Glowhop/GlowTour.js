---
interface Props {
  variant: "square" | "beacon" | "step-path" | "spotlight" | "waypoint" | "popover-g" | "arc-glow";
  class?: string;
}

const { variant, class: className = "h-6 w-6" } = Astro.props;
---

{
  variant === "square" && (
    <span
      class={`inline-flex items-center justify-center rounded-[var(--radius-glow)] bg-[var(--color-accent)] text-xs font-bold text-[var(--color-on-accent)] ${className}`}
    >
      G
    </span>
  )
}
{
  variant === "beacon" && (
    <svg viewBox="0 0 56 56" class={className} role="img" aria-label="Glow Tour">
      <circle cx="28" cy="28" r="27" fill="none" stroke="var(--color-accent)" stroke-width="1.4" opacity="0.35" />
      <circle cx="28" cy="28" r="19" fill="none" stroke="var(--color-accent)" stroke-width="1.6" opacity="0.55" />
      <circle cx="28" cy="28" r="7" fill="var(--color-accent)" />
    </svg>
  )
}
{
  variant === "step-path" && (
    <svg viewBox="0 0 56 56" class={className} role="img" aria-label="Glow Tour">
      <circle cx="12" cy="40" r="4.5" fill="var(--color-accent)" />
      <circle cx="28" cy="24" r="4.5" fill="var(--color-accent)" opacity="0.7" />
      <circle cx="44" cy="16" r="4.5" fill="var(--color-accent)" opacity="0.4" />
      <path d="M15 37 L25 27" stroke="var(--color-accent)" stroke-width="1.6" stroke-dasharray="2 3" opacity="0.6" />
      <path d="M32 21 L41 18" stroke="var(--color-accent)" stroke-width="1.6" stroke-dasharray="2 3" opacity="0.5" />
    </svg>
  )
}
{
  variant === "spotlight" && (
    <svg viewBox="0 0 56 56" class={className} role="img" aria-label="Glow Tour">
      <rect x="4" y="4" width="48" height="48" rx="12" fill="var(--color-accent)" />
      <circle cx="28" cy="28" r="12" fill="var(--color-on-accent)" />
    </svg>
  )
}
{
  variant === "waypoint" && (
    <svg viewBox="0 0 56 56" class={className} role="img" aria-label="Glow Tour">
      <path d="M28 6c-9 0-16 6.8-16 16.4C12 34 28 50 28 50s16-16 16-27.6C44 12.8 37 6 28 6Z" fill="var(--color-accent)" />
      <circle cx="28" cy="22" r="6.5" fill="var(--color-on-accent)" />
    </svg>
  )
}
{
  variant === "popover-g" && (
    <svg viewBox="0 0 56 56" class={className} role="img" aria-label="Glow Tour">
      <path
        d="M8 10h32a6 6 0 0 1 6 6v18a6 6 0 0 1-6 6H24l-8 8v-8h-8a6 6 0 0 1-6-6V16a6 6 0 0 1 6-6Z"
        fill="var(--color-accent)"
      />
      <text x="24" y="30" font-size="18" font-weight="500" fill="var(--color-on-accent)" text-anchor="middle">
        G
      </text>
    </svg>
  )
}
{
  variant === "arc-glow" && (
    <svg viewBox="0 0 56 56" class={className} role="img" aria-label="Glow Tour">
      <path
        d="M28 6a22 22 0 1 1-15.6 6.4"
        fill="none"
        stroke="var(--color-accent)"
        stroke-width="4"
        stroke-linecap="round"
      />
      <circle cx="28" cy="28" r="6" fill="var(--color-accent)" />
    </svg>
  )
}
