---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import {
  COMPARISON_CHECKED_ON,
  COMPETITOR_KEYS,
  type CompetitorKey,
  getLibrary,
} from "../lib/comparison";
import Button from "./Button.astro";
import ComparisonTable from "./ComparisonTable.astro";
import LibraryMark from "./LibraryMark.astro";

interface Props {
  competitor: CompetitorKey;
  title: string;
  description: string;
  intro: string;
}

const { competitor, title, description, intro } = Astro.props;

const glowtour = getLibrary("glowtour");
const library = getLibrary(competitor);
const heading = `GlowTour.js vs ${library.name}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const otherComparisons = COMPETITOR_KEYS.filter((key) => key !== competitor).map(getLibrary);

// One page per "GlowTour.js vs X" search, linked from /compare and the footer. The WebPage node ties
// each one back to the site and the software it is about.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: title,
      description,
      url: canonicalURL.href,
      inLanguage: "en",
      isPartOf: { "@id": "https://glowtour.dev/#website" },
      about: { "@id": "https://glowtour.dev/#software" },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "GlowTour.js", item: Astro.site?.href },
        { "@type": "ListItem", position: 2, name: heading, item: canonicalURL.href },
      ],
    },
  ],
};

const h2 = "font-heading text-2xl font-semibold tracking-tight text-text sm:text-3xl";
const link = "underline underline-offset-4 transition-colors hover:text-text";
---

<MarketingLayout title={title} description={description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <section class="mx-auto max-w-3xl px-6 pt-16 sm:pt-24">
    <div class="flex items-center gap-3" aria-hidden="true">
      <LibraryMark library={glowtour} class="h-10 w-10 p-1.5" />
      <span class="font-heading text-lg text-text-muted">vs</span>
      <LibraryMark library={library} class="h-10 w-10 p-1.5 text-xl" />
    </div>
    <p class="mt-6 text-sm font-semibold text-accent">Product tour library comparison</p>
    <h1
      class="font-heading mt-2 text-4xl leading-[1.1] font-semibold tracking-tight text-balance text-text sm:text-5xl"
    >
      {heading}
    </h1>
    <p class="mt-6 text-lg leading-relaxed text-pretty text-text-muted">{intro}</p>
  </section>

  <section id="feature-comparison" class="mx-auto max-w-3xl px-6 pt-12 scroll-mt-20">
    <h2 class={h2}>Feature comparison</h2>
    <div class="mt-6">
      <ComparisonTable
        libraries={["glowtour", competitor]}
        caption={`${heading}: feature-by-feature comparison`}
      />
    </div>
    <p class="mt-3 text-xs leading-relaxed text-text-muted">
      Checked in {COMPARISON_CHECKED_ON} against {library.name} {library.checkedVersion} and the
      current GlowTour.js docs. "Native integration" means components shipped by the project for
      that framework; "Official wrapper" means a project-maintained package around the core library;
      "Generic JS API" means the library is called from framework code directly.
    </p>
  </section>

  <article class="mx-auto max-w-3xl px-6 pt-16">
    <div class="grid gap-14">
      <slot />
    </div>
    <p class="mt-8 text-sm leading-relaxed text-text-muted">
      GlowTour.js is newer than {library.name} and ships as ESM only. Server rendering is verified
      for its React, Vue and Solid adapters but not yet for Angular; check the <a
        href="/docs/compatibility"
        class={link}>compatibility page</a
      > before adopting it.
    </p>

    <section id="sources" class="mt-14 scroll-mt-20">
      <h2 class={h2}>Sources</h2>
      <dl class="mt-6 grid gap-x-6 gap-y-3 text-sm sm:grid-cols-[10rem_1fr]">
        {
          [glowtour, library].map((source) => (
            <>
              <dt class="font-medium text-text">{source.name}</dt>
              <dd class="flex flex-wrap gap-x-4 gap-y-1 text-text-muted">
                {source.sources.map((item) => (
                  <a
                    href={item.href}
                    rel={item.href.startsWith("http") ? "noopener" : undefined}
                    class={link}
                  >
                    {item.label}
                  </a>
                ))}
              </dd>
            </>
          ))
        }
      </dl>
    </section>

    <nav aria-labelledby="other-comparisons" class="mt-14">
      <h2 id="other-comparisons" class={h2}>Other comparisons</h2>
      <ul class="mt-6 flex flex-wrap gap-3">
        {
          otherComparisons.map((other) => (
            <li>
              <Button href={other.path} variant="secondary">
                <LibraryMark library={other} />
                GlowTour.js vs {other.name}
              </Button>
            </li>
          ))
        }
      </ul>
    </nav>
  </article>

  <section class="mx-auto max-w-3xl px-6 py-20">
    <div class="flex flex-wrap gap-3">
      <Button href="/docs/getting-started">Get started</Button>
      <Button href="/examples" variant="secondary">See the examples</Button>
    </div>
  </section>
</MarketingLayout>
