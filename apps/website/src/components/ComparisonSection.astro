---
interface Props {
  id: string;
  heading: string;
}

const { id, heading } = Astro.props;
---

{/* Pages write plain <p>, <code>, <ul> and <strong>; the styling lives here so the three comparison
pages stay pure copy. */}
<section id={id} class="scroll-mt-20">
  <h2 class="font-heading text-2xl font-semibold tracking-tight text-text sm:text-3xl">
    {heading}
  </h2>
  <div
    class="[&_code]:rounded [&_code]:bg-surface-muted [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.85em] [&_code]:text-text [&_li]:text-text-muted [&_li]:marker:text-accent [&_p]:mt-4 [&_p]:leading-relaxed [&_p]:text-text-muted [&_strong]:font-semibold [&_strong]:text-text [&_ul]:mt-4 [&_ul]:grid [&_ul]:list-disc [&_ul]:gap-3 [&_ul]:pl-5"
  >
    <slot />
  </div>
</section>
