---
interface Props {
  href?: string;
  variant?: "primary" | "secondary";
  class?: string;
  type?: "button" | "submit";
}

const { href, variant = "primary", class: className = "", type = "button" } = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-[var(--radius-glow)] px-5 py-2.5 text-sm font-semibold transition-colors";
const variants = {
  primary:
    "bg-[var(--color-accent)] text-[var(--color-on-accent)] hover:bg-[var(--color-accent-hover)] active:bg-[var(--color-accent-active)]",
  secondary:
    "border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] hover:bg-[var(--color-surface-muted)]",
};

const classes = [base, variants[variant], className].join(" ");
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
