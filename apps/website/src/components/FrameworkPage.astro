---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { formatKib, frameworkBundle } from "../lib/bundle-sizes";
import Button from "./Button.astro";
import CodeBlock from "./CodeBlock.astro";
import CopyButton from "./CopyButton.astro";
import FrameworkIcon from "./FrameworkIcon.astro";

interface Props {
  name: string;
  icon: "react" | "vue" | "solid" | "angular" | "vanilla";
  packageName: string;
  installCommand: string;
  intro: string;
  code: string;
  lang: string;
  guideHref: string;
  title: string;
  description: string;
  benefits: Array<{ title: string; description: string }>;
  faq: Array<{ question: string; answer: string }>;
}

const {
  name,
  icon,
  packageName,
  installCommand,
  intro,
  code,
  lang,
  guideHref,
  title,
  description,
  benefits,
  faq,
} = Astro.props;

const bundle = frameworkBundle(icon);
const npmPackage = `@glowhop/${packageName}-tour`;
const npmUrl = `https://www.npmjs.com/package/${npmPackage}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Each adapter page is a distinct package landing page; describing it as its own
// SoftwareSourceCode (plus a breadcrumb back to the site root) keeps the five of them from
// looking like near-duplicates of the home page to a crawler.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareSourceCode",
      name: npmPackage,
      description,
      url: canonicalURL.href,
      codeRepository: "https://github.com/Glowhop/GlowTour.js",
      downloadUrl: npmUrl,
      programmingLanguage: "TypeScript",
      runtimePlatform: name,
      license: "https://github.com/Glowhop/GlowTour.js/blob/main/LICENSE",
      isPartOf: { "@id": "https://glowtour.dev/#website" },
    },
    {
      "@type": "FAQPage",
      mainEntity: faq.map(({ question, answer }) => ({
        "@type": "Question",
        name: question,
        acceptedAnswer: {
          "@type": "Answer",
          text: answer,
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "GlowTour.js", item: Astro.site?.href },
        { "@type": "ListItem", position: 2, name, item: canonicalURL.href },
      ],
    },
  ],
};
---

<MarketingLayout title={title} description={description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <section class="mx-auto max-w-4xl px-6 py-16 sm:py-24">
    <div class="flex items-center gap-2">
      <FrameworkIcon name={icon} class="h-5 w-5 text-accent" />
      <p class="text-sm font-semibold text-accent">{name}</p>
    </div>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight text-text">
      GlowTour.js for {name}
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-text-muted">{intro}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={guideHref}>Read the {name} guide</Button>
      <Button href="/docs/getting-started" variant="secondary">Getting started</Button>
    </div>

    <div class="mt-12">
      <h2 class="text-sm font-semibold text-text-muted uppercase tracking-wide">
        Install
      </h2>
      <div
        data-tour="framework-install"
        class="mt-3 flex items-center gap-2 rounded-glow border border-border bg-surface-muted py-3 pr-3 pl-4"
      >
        <div class="min-w-0 flex-1 overflow-x-auto">
          <code class="font-mono text-sm whitespace-nowrap">{installCommand}</code>
        </div>
        <CopyButton value={installCommand} label="Copy install command" iconOnly />
      </div>
      <p class="mt-3 text-sm text-text-muted">
        {formatKib(bundle.total)} gzipped in total: {formatKib(bundle.adapter)} of adapter over the
        shared {formatKib(bundle.core)} engine, plus {formatKib(bundle.styles)} of theme CSS you can
        replace with your own.
      </p>
      <p class="mt-3 text-sm text-text-muted">
        <a
          href={npmUrl}
          rel="noopener"
          class="underline underline-offset-4 transition-colors hover:text-text"
        >
          {npmPackage} on npm
        </a>
        {" · "}
        <a
          href="https://www.npmjs.com/package/@glowhop/styles-tour"
          rel="noopener"
          class="underline underline-offset-4 transition-colors hover:text-text"
        >
          @glowhop/styles-tour on npm
        </a>
      </p>
    </div>

    <div class="mt-10">
      <h2 class="text-sm font-semibold text-text-muted uppercase tracking-wide">
        Quick start
      </h2>
      <p class="mt-2 text-sm text-text-muted">
        {icon === "vanilla" ? (
          <>From <code>examples/{packageName}</code> in the GlowTour.js repository - copy, paste, run.</>
        ) : (
          <>A component-scoped integration using the {name} lifecycle API. See the full guide for additional setup and customization.</>
        )}
      </p>
      <div data-tour="framework-quickstart">
        <CodeBlock code={code} lang={lang} class="mt-3" />
      </div>
    </div>

    <div class="mt-16">
      <h2 class="text-2xl font-semibold tracking-tight text-text">
        Why use GlowTour.js with {name}?
      </h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-3">
        {
          benefits.map((benefit) => (
            <article class="rounded-glow border border-border bg-surface p-5">
              <h3 class="font-semibold text-text">{benefit.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-text-muted">{benefit.description}</p>
            </article>
          ))
        }
      </div>
    </div>

    <div class="mt-16">
      <h2 class="text-2xl font-semibold tracking-tight text-text">
        {name} product tour FAQ
      </h2>
      <div class="mt-6 divide-y divide-border border-y border-border">
        {
          faq.map((item) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-text">
                {item.question}
                <span class="text-accent transition-transform group-open:rotate-45" aria-hidden="true">
                  +
                </span>
              </summary>
              <p class="mt-3 max-w-3xl leading-relaxed text-text-muted">{item.answer}</p>
            </details>
          ))
        }
      </div>
      <p class="mt-6 text-sm text-text-muted">
        Need the complete API and framework-specific setup?{" "}
        <a
          href={guideHref}
          class="font-medium text-text underline underline-offset-4 transition-colors hover:text-accent"
        >
          Read the {name} integration guide
        </a>.
      </p>
    </div>
  </section>
</MarketingLayout>
