---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { formatKib, frameworkBundle } from "../lib/bundle-sizes";
import Button from "./Button.astro";
import CodeBlock from "./CodeBlock.astro";
import CopyButton from "./CopyButton.astro";
import FrameworkIcon from "./FrameworkIcon.astro";

interface Props {
  name: string;
  icon: "react" | "vue" | "solid" | "angular" | "vanilla";
  packageName: string;
  installCommand: string;
  intro: string;
  code: string;
  lang: string;
  guideHref: string;
  title: string;
  description: string;
}

const {
  name,
  icon,
  packageName,
  installCommand,
  intro,
  code,
  lang,
  guideHref,
  title,
  description,
} = Astro.props;

const bundle = frameworkBundle(icon);
const npmPackage = `@glowhop/${packageName}-tour`;
const npmUrl = `https://www.npmjs.com/package/${npmPackage}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Each adapter page is a distinct package landing page; describing it as its own
// SoftwareSourceCode (plus a breadcrumb back to the site root) keeps the five of them from
// looking like near-duplicates of the home page to a crawler.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareSourceCode",
      name: npmPackage,
      description,
      url: canonicalURL.href,
      codeRepository: "https://github.com/Glowhop/GlowTour.js",
      downloadUrl: npmUrl,
      programmingLanguage: "TypeScript",
      runtimePlatform: name,
      license: "https://github.com/Glowhop/GlowTour.js/blob/main/LICENSE",
      isPartOf: { "@id": "https://glowtour.dev/#website" },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "GlowTour.js", item: Astro.site?.href },
        { "@type": "ListItem", position: 2, name, item: canonicalURL.href },
      ],
    },
  ],
};
---

<MarketingLayout title={title} description={description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <section class="mx-auto max-w-4xl px-6 py-16 sm:py-24">
    <div class="flex items-center gap-2">
      <FrameworkIcon name={icon} class="h-5 w-5 text-accent" />
      <p class="text-sm font-semibold text-accent">{name}</p>
    </div>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight text-text">
      GlowTour.js for {name}
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-text-muted">{intro}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={guideHref}>Read the {name} guide</Button>
      <Button href="/docs/getting-started" variant="secondary">Getting started</Button>
    </div>

    <div class="mt-12">
      <h2 class="text-sm font-semibold text-text-muted uppercase tracking-wide">
        Install
      </h2>
      <div
        data-tour="framework-install"
        class="mt-3 flex items-center gap-2 rounded-glow border border-border bg-surface-muted py-3 pr-3 pl-4"
      >
        <div class="min-w-0 flex-1 overflow-x-auto">
          <code class="font-mono text-sm whitespace-nowrap">{installCommand}</code>
        </div>
        <CopyButton value={installCommand} label="Copy install command" iconOnly />
      </div>
      <p class="mt-3 text-sm text-text-muted">
        {formatKib(bundle.total)} gzipped in total: {formatKib(bundle.adapter)} of adapter over the
        shared {formatKib(bundle.core)} engine, plus {formatKib(bundle.styles)} of theme CSS you can
        replace with your own.
      </p>
      <p class="mt-3 text-sm text-text-muted">
        <a
          href={npmUrl}
          rel="noopener"
          class="underline underline-offset-4 transition-colors hover:text-text"
        >
          {npmPackage} on npm
        </a>
        {" · "}
        <a
          href="https://www.npmjs.com/package/@glowhop/styles-tour"
          rel="noopener"
          class="underline underline-offset-4 transition-colors hover:text-text"
        >
          @glowhop/styles-tour on npm
        </a>
      </p>
    </div>

    <div class="mt-10">
      <h2 class="text-sm font-semibold text-text-muted uppercase tracking-wide">
        Quick start
      </h2>
      <p class="mt-2 text-sm text-text-muted">
        From <code>examples/{packageName}</code> in the GlowTour.js repository - copy, paste, run.
      </p>
      <div data-tour="framework-quickstart">
        <CodeBlock code={code} lang={lang} class="mt-3" />
      </div>
    </div>
  </section>
</MarketingLayout>
