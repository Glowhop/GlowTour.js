---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Button from "./Button.astro";
import CodeBlock from "./CodeBlock.astro";
import FrameworkIcon from "./FrameworkIcon.astro";

interface Props {
  name: string;
  icon: "react" | "vue" | "solid" | "angular" | "vanilla";
  packageName: string;
  installCommand: string;
  intro: string;
  code: string;
  lang: string;
  guideHref: string;
  title: string;
  description: string;
}

const {
  name,
  icon,
  packageName,
  installCommand,
  intro,
  code,
  lang,
  guideHref,
  title,
  description,
} = Astro.props;

const npmPackage = `@glowhop/${packageName}-tour`;
const npmUrl = `https://www.npmjs.com/package/${npmPackage}`;
---

<MarketingLayout title={title} description={description}>
  <section class="mx-auto max-w-4xl px-6 py-16 sm:py-24">
    <div class="flex items-center gap-2">
      <FrameworkIcon name={icon} class="h-5 w-5 text-[var(--color-accent)]" />
      <p class="text-sm font-semibold text-[var(--color-accent)]">{name}</p>
    </div>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight text-[var(--color-text)]">
      GlowTour.js for {name}
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-[var(--color-text-muted)]">{intro}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={guideHref}>Read the {name} guide</Button>
      <Button href="/docs/getting-started" variant="secondary">Getting started</Button>
    </div>

    <div class="mt-12">
      <h2 class="text-sm font-semibold text-[var(--color-text-muted)] uppercase tracking-wide">
        Install
      </h2>
      <div class="mt-3 overflow-x-auto rounded-[var(--radius-glow)] border border-[var(--color-border)] bg-[var(--color-surface-muted)] p-4 font-mono text-sm">
        {installCommand}
      </div>
      <p class="mt-3 text-sm text-[var(--color-text-muted)]">
        <a
          href={npmUrl}
          rel="noopener"
          class="underline underline-offset-4 transition-colors hover:text-[var(--color-text)]"
        >
          {npmPackage} on npm
        </a>
        {" · "}
        <a
          href="https://www.npmjs.com/package/@glowhop/styles-tour"
          rel="noopener"
          class="underline underline-offset-4 transition-colors hover:text-[var(--color-text)]"
        >
          @glowhop/styles-tour on npm
        </a>
      </p>
    </div>

    <div class="mt-10">
      <h2 class="text-sm font-semibold text-[var(--color-text-muted)] uppercase tracking-wide">
        Quick start
      </h2>
      <p class="mt-2 text-sm text-[var(--color-text-muted)]">
        From <code>examples/{packageName}</code> in the GlowTour.js repository — copy, paste, run.
      </p>
      <CodeBlock code={code} lang={lang} class="mt-3" />
    </div>
  </section>
</MarketingLayout>
