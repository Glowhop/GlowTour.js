---
import FrameworkPage from "../components/FrameworkPage.astro";
import { angularSource } from "../lib/framework-sources";
---

<FrameworkPage
  name="Angular"
  icon="angular"
  packageName="angular"
  installCommand="bun add @glowhop/angular-tour @glowhop/styles-tour"
  intro="Standalone Angular 18 components with a DI-scoped root, distributed in Angular Package Format with partial compilation. Drop GlowTourDefault into any standalone component template."
  code={angularSource}
  lang="ts"
  guideHref="/docs/guides/angular"
  title="Glow Tour for Angular — guided tours for Angular 18"
  description="Add accessible guided tours to an Angular 18 app with @glowhop/angular-tour: createGlowTour, a step builder, and a GlowTourDefault component."
/>
