---
import FrameworkPage from "../components/FrameworkPage.astro";
import { reactSource } from "../lib/framework-sources";
---

<FrameworkPage
  name="React"
  icon="react"
  packageName="react"
  installCommand="npm i @glowhop/react-tour @glowhop/styles-tour"
  intro="Native React components and a Context-scoped tour instance, built for React 18 and 19. No portals to wire up yourself - DefaultTour renders the popover, overlay, and pointer for you."
  code={reactSource}
  lang="tsx"
  guideHref="/docs/guides/react"
  title="React Product Tour Library - GlowTour.js"
  description="Build accessible, SSR-safe product tours and guided onboarding for React 18/19 with @glowhop/react-tour, a typed step builder, and DefaultTour."
/>
