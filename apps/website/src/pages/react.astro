---
import FrameworkPage from "../components/FrameworkPage.astro";
import { reactSource } from "../lib/framework-sources";
---

<FrameworkPage
  name="React"
  headline="React product tour & onboarding library"
  icon="react"
  packageName="react"
  installCommand="npm i @glowhop/react-tour @glowhop/styles-tour"
  intro="Native React components and a Context-scoped tour instance, built for React 18 and 19. No portals to wire up yourself - GlowTourDefault renders the popover, overlay, and pointer for you."
  code={reactSource}
  lang="tsx"
  guideHref="/docs/guides/react/"
  title="React Product Tour & Onboarding Library | GlowTour.js"
  description="Add product tours and onboarding tours to React 18/19 and Next.js apps with @glowhop/react-tour: native components, typed builder, accessible, MIT licensed."
  steps={[
  "Install the adapter and the default theme with npm i @glowhop/react-tour @glowhop/styles-tour, then import \"@glowhop/styles-tour/default.css\" once, in your app entry or the component that renders the tour.",
  "Call useGlowTour() inside a React component. It returns the tour instance plus create, start, cancel and the current status.",
  "Describe the onboarding tour with the builder: create(\"product-tour\").step({ id, target, title, content }).build(), one step per element you want to highlight.",
  "Render <GlowTourDefault tour={tour} /> once and call start(workflow) from an event handler, such as a \"Take the tour\" button or the first visit after sign-up."
]}
  benefits={[
  {
    "title": "React-native rendering",
    "description": "Use React components and a Context-scoped instance instead of wrapping an imperative DOM library."
  },
  {
    "title": "React 18 and 19 support",
    "description": "Run the same typed tour workflow in current React applications, with SSR-safe behavior for Next.js."
  },
  {
    "title": "Composable by design",
    "description": "Use GlowTourDefault immediately or compose the lower-level React primitives into your own interface."
  }
]}
  faq={[
  {
    "question": "How do I create a product tour in React?",
    "answer": "Install @glowhop/react-tour and @glowhop/styles-tour, call useGlowTour() inside a React component, build a workflow with create(), render GlowTourDefault with the returned tour, then call start() from an event handler."
  },
  {
    "question": "Does GlowTour.js work with Next.js?",
    "answer": "Yes. Keep tour creation and rendering in a client component, import the default theme once, and render GlowTourDefault near your application root. The React adapter is tested against server rendering and hydration."
  },
  {
    "question": "Can I customize the React tour UI?",
    "answer": "Yes. You can replace the default theme with your own CSS or compose the React adapter's lower-level components when you need full control over the popover, overlay, pointer, and controls."
  },
  {
    "question": "Is GlowTour.js a React Joyride alternative?",
    "answer": "Yes. Both render product tours as React components. GlowTour.js adds a chainable builder, composable popover primitives, verified server rendering in Next.js, and the same tour engine for Vue, Angular, Solid and vanilla JavaScript if your product is not React-only."
  }
]}
/>
