---
import ApiComparison from "../components/ApiComparison.astro";
import ComparisonPage from "../components/ComparisonPage.astro";
import ComparisonSection from "../components/ComparisonSection.astro";
---

{/*
  Astro drops the whitespace of a line break that sits right next to an inline element, so the
  prose below only ever wraps between two plain words, never before or after <code> or <strong>.
*/}
<ComparisonPage
  competitor="joyride"
  title="React Joyride Alternative: GlowTour.js vs React Joyride"
  description="Looking for a React Joyride alternative? Compare GlowTour.js and React Joyride across framework support, customization, SSR, accessibility and licensing."
  intro="React Joyride is a React-focused product tour library; GlowTour.js is framework-agnostic, with native adapters for React, Vue, Angular, Solid and vanilla JavaScript. For a React-only product both are options. If you are looking for a React Joyride alternative, the main differences are framework reach, workflow APIs and how you customize the UI."
  glowtourBestFor="You need the same tour model across React, Vue, Angular, Solid or vanilla JavaScript, or prefer a chainable workflow builder and composable UI primitives."
  competitorBestFor="Your product is React-only, may support React versions before 18, and fits React Joyride's component, hook and steps-prop model."
  faq={[
    {
      question: "Is GlowTour.js a React Joyride alternative?",
      answer:
        "Yes. Both provide React product tours with customizable UI and accessible navigation. GlowTour.js also supports Vue, Angular, Solid and vanilla JavaScript through first-party adapters.",
    },
    {
      question: "Which library is better for a React-only application?",
      answer:
        "Either can fit. React Joyride is dedicated to React and supports older React versions. GlowTour.js is useful when you want a builder-style workflow API, composable tour primitives, or a path to reuse tours in other frameworks.",
    },
    {
      question: "Do GlowTour.js and React Joyride work with Next.js?",
      answer:
        "Both are designed to be SSR-safe. GlowTour.js verifies its React adapter in a production Next.js app; tour workflows should still start on the client after their target elements are mounted.",
    },
  ]}
>
  <ComparisonSection id="react-only-vs-agnostic" heading="React-only vs framework-agnostic">
    <p>
      React Joyride supports React 16.8 through 19, with a <code>&lt;Joyride&gt;</code> component
      and a <code>useJoyride</code> hook. It does not target Vue, Angular or plain JavaScript pages.
    </p>
    <p>
      GlowTour.js keeps tour logic in a framework-agnostic core, so the same workflow definition runs
      in React, Vue, Angular, Solid and vanilla JavaScript. Its React adapter supports React 18 and
      19.
    </p>
  </ComparisonSection>

  <ComparisonSection id="vue-angular-support" heading="Vue and Angular support">
    <p>
      If your organization runs Vue or Angular apps alongside React, React Joyride cannot be reused
      there. GlowTour.js provides native Vue components and Angular standalone components with the
      same builder API, keyboard shortcuts and ARIA semantics as its React adapter.
    </p>
  </ComparisonSection>

  <ComparisonSection id="ui-customization" heading="UI customization approach">
    <p>
      React Joyride lets you replace its UI with your own React components through the <code
        >tooltipComponent</code
      >, <code>beaconComponent</code> and <code>arrowComponent</code> props, alongside styling
      options.
    </p>
    <p>
      GlowTour.js offers composition primitives (Root, Popover, Header, Content, Footer and trigger
      components) in every supported framework, plus <code>--glow-tour-*</code> CSS custom properties
      for theming.
    </p>
  </ComparisonSection>


  <ApiComparison
    competitorName="React Joyride"
    competitorCode={"import Joyride from \"react-joyride\";\n\nconst steps = [\n  {\n    target: \"#welcome\",\n    title: \"Welcome\",\n    content: \"Start here\",\n  },\n];\n\nexport function Tour() {\n  return <Joyride steps={steps} />;\n}"}
    competitorLang="tsx"
    glowtourCode={"import {\n  createGlowTour,\n  GlowTourDefault,\n} from \"@glowhop/react-tour\";\n\nconst tour = createGlowTour();\nconst workflow = tour\n  .create(\"onboarding\")\n  .step({\n    id: \"welcome\",\n    target: \"#welcome\",\n    title: \"Welcome\",\n    content: \"Start here\",\n  })\n  .build();\n\nexport function Tour() {\n  return <GlowTourDefault tour={tour} />;\n}"}
    glowtourLang="tsx"
  />

  <ComparisonSection id="accessibility-ssr-licensing" heading="Accessibility, SSR and licensing">
    <p>
      Both document focus trapping, keyboard navigation and ARIA support, and both are MIT licensed.
      React Joyride describes itself as SSR-safe with Next.js and Remix; GlowTour.js verifies server
      rendering and hydration for its React, Vue and Solid adapters, including a production Next.js
      app.
    </p>
  </ComparisonSection>

  <ComparisonSection id="which-to-choose" heading="Should you choose GlowTour.js or React Joyride?">
    <ul>
      <li>
        <strong>Choose React Joyride</strong> if your application is React-only and you want a
        React-focused library, including support for React versions before 18.
      </li>
      <li>
        <strong>Choose GlowTour.js</strong> if you need the same tours across React, Vue or Angular,
        or want to compose the popover UI from components with a builder-style API.
      </li>
    </ul>
  </ComparisonSection>
</ComparisonPage>
